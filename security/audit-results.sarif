                  "endLine": 57,
                  "endColumn": 63
                }
              },
              "logicalLocations": [
                {
                  "name": "delete_booking",
                  "kind": "function"
                }
              ]
            }
          ],
          "properties": {
            "status": "remediated",
            "remediatedInCommit": "phase-5-actor-remediation"
          }
        },
        {
          "ruleId": "R4",
          "ruleIndex": 2,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "REMEDIATED: pyyaml upgraded from 5.4.1 (CVE-2017-18342, CVSS 9.8) to 6.0.1. Arbitrary code execution vector eliminated.",
            "id": "R4_F3_remediated"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "requirements.txt",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 12,
                  "startColumn": 1,
                  "endLine": 12,
                  "endColumn": 14
                }
              }
            }
          ],
          "fixes": [
            {
              "description": {
                "text": "Upgrade pyyaml from 5.4.1 to 6.0.1 to remediate CVE-2017-18342 (CVSS 9.8)"
              },
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "requirements.txt",
                    "uriBaseId": "%SRCROOT%"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 12,
                        "endLine": 12
                      },
                      "insertedContent": {
                        "text": "pyyaml==6.0.1\n"
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "properties": {
            "status": "remediated",
            "cve": "CVE-2017-18342",
            "cvss": "9.8",
            "remediatedInCommit": "phase-5-actor-remediation"
          }
        }
      ],
      "artifacts": [
